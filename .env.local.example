# Supabase Configuration
# Copy this file to .env.local and fill in your actual values

# Supabase Project URL
# Get this from your Supabase project dashboard: Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable Key (default)
# Get this from your Supabase project dashboard: Settings > API > Project API keys > publishable_default
# This is safe to expose in client-side code as it's protected by Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key-here

# WARNING: This key bypasses Row Level Security. 
# NEVER prefix with NEXT_PUBLIC_ — it must stay server-side only.
# Never share it publicly. If leaked, generate a new JWT secret immediately. 
SUPABASE_SERVICE_ROLE_KEY=secret_key

# Optional secret used by automated cron endpoints (for example Vercel Cron).
# When set, cron requests must send: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change_me

# Stripe Configuration
# Get these from your Stripe dashboard: Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_TEAM_PRICE_ID=price_...

# Optional local-only performance instrumentation (0 or 1)
# Exposes window.__WORKBENCH_NAV_PERF__ with navigation/request counters.
NEXT_PUBLIC_ENABLE_NAV_PERF=0

# Sentry (https://sentry.io) — error monitoring, tracing, session replay
# Client DSN (safe to expose; used by the browser SDK)
NEXT_PUBLIC_SENTRY_DSN=

# Server and Edge SDK DSN (same project as above; omit NEXT_PUBLIC_ prefix in server-only contexts)
# If unset, server falls back to NEXT_PUBLIC_SENTRY_DSN at runtime.
SENTRY_DSN=

# Build-time: upload source maps (create a token with project:releases and org:read scopes)
# Prefer storing in a gitignored file — see .env.sentry-build-plugin in .gitignore
SENTRY_AUTH_TOKEN=
# Optional if not set in next.config.ts:
# SENTRY_ORG=lesot-cyril
# SENTRY_PROJECT=javascript-nextjs